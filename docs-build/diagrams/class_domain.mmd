%% size: 2400x2400
classDiagram
  direction TB
  class User {
    +int id
    +Role role
    +string firstName
    +string lastName
    +string email
    -string passwordHash
    +Status status
    +login(email, password) Token
    +logout()
    +changePassword(current, next)
  }
  class Student {
    +string nationality
    +Level targetLevel
    +string field
    +float gpa
    +LanguageScore language
    +string[] preferredCountries
    +Funding fundingPref
    +int stage
    +uploadDocument(type, file) Document
    +requestService(service) ServiceRequest
    +readiness() Readiness
  }
  class Employee {
    +Department department
    +string title
    +reviewDocument(doc, decision)
    +assignRequest(request)
    +updateStage(application, stage)
    +logCommunication(student, entry)
  }
  class Administrator {
    +manageUsers()
    +manageRoles()
    +viewReports() Report
  }
  class Scholarship {
    +int id
    +string name
    +string country
    +Level[] levels
    +string[] fields
    +float minGpa
    +LanguageScore language
    +Funding funding
    +Date deadline
    +ScholarshipStatus status
    +ResultsStatus results
  }
  class Document {
    +int id
    +DocType type
    +string fileName
    +DocStatus status
    +string rejectReason
  }
  class Application {
    +string code
    +int stage
    +Result result
    +moveTo(stage)
  }
  class ServiceRequest {
    +int id
    +ServiceType service
    +Priority priority
    +RequestStatus status
  }
  class MatchResult {
    +int score
    +MatchLevel level
    +map parts
    +string explanation
  }
  class Notification {
    +NotificationType type
    +string title
    +Date readAt
  }
  User <|-- Student
  User <|-- Employee
  User <|-- Administrator
  Student "1" --> "0..*" Document : uploads
  Student "1" --> "0..*" Application : submits
  Student "1" --> "0..*" ServiceRequest : requests
  Scholarship "1" --> "0..*" Application : receives
  Student "1" --> "0..*" MatchResult : scored
  Scholarship "1" --> "0..*" MatchResult : scored
  Employee "1" --> "0..*" ServiceRequest : handles
  Employee "1" --> "0..*" Application : advises
  Application "0..*" o-- "0..*" Document : attaches
  User "1" --> "0..*" Notification : receives
