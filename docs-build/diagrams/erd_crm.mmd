%% size: 2400x2300
erDiagram
  services {
    VARCHAR code PK
    VARCHAR name_en
    VARCHAR name_ar
    TINYINT active
  }
  service_requests {
    INT id PK
    INT student_id FK
    VARCHAR service_code FK
    INT scholarship_id FK
    ENUM priority
    TEXT notes
    ENUM status "newRequest..completed"
    INT assigned_to FK
  }
  applications {
    INT id PK
    VARCHAR code UK "APP-2041"
    INT student_id FK
    INT scholarship_id FK
    INT advisor_id FK
    TINYINT stage "0..7"
    ENUM result "accepted|rejected"
  }
  application_stage_history {
    INT id PK
    INT application_id FK
    TINYINT from_stage
    TINYINT to_stage
    INT changed_by FK
    VARCHAR note
  }
  notes {
    INT id PK
    INT student_id FK
    INT author_id FK
    TEXT body
  }
  communications {
    INT id PK
    INT student_id FK
    INT employee_id FK
    ENUM channel "call|whatsapp|email|meeting"
    ENUM direction
    TEXT summary
    DATE follow_up_on
  }
  contact_messages {
    INT id PK
    VARCHAR name
    VARCHAR email
    VARCHAR phone
    ENUM subject
    TEXT message
  }
  services ||--o{ service_requests : "type of"
  applications ||--o{ application_stage_history : "history"
  applications }o--|| scholarships_ref : "for"
  service_requests }o--|| students_ref : "by"
  applications }o--|| students_ref : "by"
  notes }o--|| students_ref : "about"
  communications }o--|| students_ref : "about"
  students_ref { INT user_id PK "students" }
  scholarships_ref { INT id PK "scholarships" }
