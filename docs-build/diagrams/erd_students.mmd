%% size: 2400x2200
erDiagram
  users ||--o| students : "1 : 0..1"
  students {
    INT user_id PK,FK
    VARCHAR first_name_ar
    ENUM gender
    DATE birth_date
    VARCHAR nationality
    ENUM current_level
    ENUM target_level
    VARCHAR field
    DECIMAL gpa
    DECIMAL gpa_scale
    VARCHAR institution
    VARCHAR language_test
    DECIMAL language_score
    ENUM funding_pref
    INT assigned_to FK "advisor"
    ENUM priority
    TINYINT stage "0..7"
  }
  student_countries {
    INT student_id PK,FK
    VARCHAR country PK
  }
  document_types {
    VARCHAR code PK
    VARCHAR name_en
    VARCHAR name_ar
    TINYINT readiness_weight
    TINYINT is_required
  }
  documents {
    INT id PK
    INT student_id FK
    VARCHAR type_code FK
    VARCHAR file_name
    VARCHAR stored_path
    VARCHAR mime_type
    INT size_bytes
    ENUM status "underReview|approved|rejected"
    VARCHAR reject_reason
    INT reviewed_by FK
    DATETIME uploaded_at
  }
  application_documents {
    INT application_id PK,FK
    INT document_id PK,FK
  }
  students ||--o{ student_countries : "prefers (max 3)"
  students ||--o{ documents : "uploads"
  document_types ||--o{ documents : "classifies"
  documents ||--o{ application_documents : "reused in"
