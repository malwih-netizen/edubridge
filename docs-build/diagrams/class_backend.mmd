%% size: 2400x2300
classDiagram
  direction LR
  class Router {
    -routes array
    +get(path, handler, roles)
    +post(path, handler, roles)
    +dispatch(Request) never
  }
  class Request {
    +method string
    +path string
    +user array
    +body() array
    +bearerToken() string
    +lang() string
  }
  class Response {
    +json(data, status)$
    +error(status, code, details)$
    +cors()$
  }
  class Auth {
    +issueToken(user, req)$ string
    +authenticate(req)$
    +publicUser(user)$ array
  }
  class Jwt {
    +encode(payload)$ string
    +decode(token)$ array
  }
  class Database {
    -pdo PDO
    +all(sql, params)$ array
    +one(sql, params)$ array
    +run(sql, params)$ int
    +transaction(fn)$
  }
  class Validator {
    +check(data, rules)$ array
  }
  class Matching {
    +WEIGHTS$
    +score(student, scholarship)$ array
    +recommend(id, student, list)$ array
    +readiness(studentId)$ array
  }
  class Mapper {
    +scholarships(where, params)$ array
    +student(userId)$ array
    +document(row)$ array
  }
  class AuthController {
    +register(req)
    +login(req)
    +me(req)
    +logout(req)
    +forgot(req)
    +resetPassword(req)
  }
  class StudentController {
    +profile(req)
    +documents(req)
    +upload(req)
    +readiness(req)
    +recommendations(req)
    +applications(req)
  }
  class ScholarshipController {
    +index(req)
    +show(req, id)
    +store(req)
    +update(req, id)
    +results(req, id)
  }
  class AccountController {
    +sessions(req)
    +revokeSession(req, id)
    +changeEmail(req)
    +changePassword(req)
  }
  Router --> Request
  Router ..> Auth : protected routes
  Auth ..> Jwt
  Auth ..> Database
  AuthController ..> Validator
  AuthController ..> Auth
  StudentController ..> Matching
  StudentController ..> Mapper
  ScholarshipController ..> Mapper
  Matching ..> Database
  Mapper ..> Database
  AccountController ..> Database
  AuthController ..> Response
