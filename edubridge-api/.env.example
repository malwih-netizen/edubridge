# ── EduBridge API settings ──────────────────────────────────────────
APP_ENV=local
APP_URL=http://localhost:8000
# React dev server allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:5173

# MySQL / MariaDB (XAMPP defaults)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=edubridge
DB_USER=root
DB_PASS=

# Long random string used to sign login tokens (php -r "echo bin2hex(random_bytes(32));")
JWT_SECRET=change-me
JWT_TTL_HOURS=72
