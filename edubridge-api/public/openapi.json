          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "e.g. germany, canada, uk",
            "schema": {
              "type": "string"
            },
            "example": "germany"
          },
          {
            "name": "field",
            "in": "query",
            "required": false,
            "description": "e.g. engineering, computerScience",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "funding",
            "in": "query",
            "required": false,
            "description": "full | partial | self",
            "schema": {
              "type": "string"
