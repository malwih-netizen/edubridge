{
  "openapi": "3.0.3",
  "info": {
    "title": "EduBridge API",
    "version": "1.0.0",
    "description": "Smart Scholarship and Student Services Management System.\n\n1. Run **POST /auth/login** with `student@edubridge.app` / `demo1234` (or advisor@ / admin@).\n2. Copy the `token` and press **Authorize** at the top.\n\nErrors always look like `{\"error\": {\"code\": \"...\", \"details\": {...}}}`."
  },
  "servers": [
    {
      "url": "/api",
      "description": "This server (same domain)"
    },
    {
      "url": "https://edubridge.infinityfreeapp.com/api",
      "description": "Hosted — InfinityFree"
    },
    {
      "url": "http://localhost:8000/api",
      "description": "Local (php -S localhost:8000)"
    }
  ],
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Auth"
    },
    {
      "name": "Scholarships"
    },
    {
      "name": "Student"
    },
    {
      "name": "Account"
    },
    {
      "name": "Public"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "API and database status",
        "description": "**Access:** Public",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "status": "ok",
                  "database": "10.4.32-MariaDB",
                  "time": "2026-10-25T17:36:20+02:00"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in (saves the token in Postman automatically)",
        "description": "**Access:** Public",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "token": "<JWT>",
                  "user": {
                    "id": 1,
                    "role": "student",
                    "email": "student@edubridge.app",
                    "name": "Sarah Ahmed",
                    "nameAr": "سارة أحمد",
                    "title": null,
                    "titleAr": null
                  }
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "invalid_credentials",
                    "message": "invalid_credentials"
                  }
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "student@edubridge.app",
                "password": "demo1234"
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create a student account",
        "description": "**Access:** Public",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "token": "<JWT>",
                  "user": {
                    "id": 11,
                    "role": "student",
                    "email": "lina@example.com",
                    "name": "Lina Saleh",
                    "nameAr": null,
                    "title": null,
                    "titleAr": null
                  }
                }
              }
            }
          },
          "409": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "email_taken",
                    "message": "email_taken",
                    "details": {
                      "email": "taken"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "validation_failed",
                    "message": "validation_failed",
                    "details": {
                      "email": "email"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "firstName": "Lina",
                "lastName": "Saleh",
                "email": "lina@example.com",
                "password": "secret123",
                "gender": "female",
                "nationality": "palestine",
                "currentLevel": "bachelor",
                "level": "master",
                "field": "engineering",
                "gpa": "3.5",
                "countries": [
                  "germany",
                  "canada"
                ],
                "funding": "full",
                "help": "full"
              }
            }
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": [
          "Auth"
        ],
        "summary": "Current user",
        "description": "**Access:** Any signed-in user",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "id": 1,
                  "role": "student",
                  "email": "student@edubridge.app",
                  "name": "Sarah Ahmed",
                  "nameAr": "سارة أحمد",
                  "title": null,
                  "titleAr": null
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "unauthenticated",
                    "message": "unauthenticated"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Send a 6-digit reset code (returned as devCode in local mode)",
        "description": "**Access:** Public",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "sent": true,
                  "devCode": "482913"
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "student@edubridge.app"
              }
            }
          }
        }
      }
    },
    "/auth/verify-code": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Check the reset code",
        "description": "**Access:** Public",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "resetToken": "7.9f2c…"
                }
              }
            }
          },
          "422": {
            "description": "Error",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "invalid_code",
                    "message": "invalid_code"
                  }
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "student@edubridge.app",
                "code": "482913"
              }
            }
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Set a new password",
        "description": "**Access:** Public",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "ok": true
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "resetToken": "7.9f2c…",
                "password": "newSecret123"
              }
            }
          }
        }
      }
    },
    "/auth/resend-confirmation": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Resend the email confirmation",
        "description": "**Access:** Public",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "example": {
                  "sent": true
                }
              }
            }
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "student@edubridge.app"
              }
            }
          }
        }
      }
    },
