            "description": "Success",
            "content": {
              "application/json": {
                "example": [
                  {
                    "id": 2,
                    "name": "DAAD Graduate Scholarship",
                    "nameAr": "منحة DAAD للدراسات العليا",
                    "university": "Technical University of Munich",
                    "universityAr": "الجامعة التقنية في ميونخ",
                    "country": "germany",
                    "levels": [
                      "master",
                      "phd"
                    ],
                    "fields": [
                      "engineering",
                      "computerScience",
                      "science"
                    ],
